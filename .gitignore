# --- generated runtime data (do not commit) ---
lab.db
lab.db-journal
lab.db-shm
lab.db-wal
lab.dump.sql

# --- private animation working data (resources stay local) ---
work/
imports/

# --- character profiles are per-user; only ship the template ---
skills/libu-gen/references/characters/*
!skills/libu-gen/references/characters/README.md
!skills/libu-gen/references/characters/example.md

# --- compiled native binaries (rebuild per machine) ---
skills/libu-gen/bgrm

